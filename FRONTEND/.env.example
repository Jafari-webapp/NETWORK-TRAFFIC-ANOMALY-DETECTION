# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/network_anomaly_db

# --- Gemini LLM ---
GEMINI_API_KEY=my_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- Auth / JWT ---
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# --- ML model paths ---
ML_PIPELINE_PATH=models/production_network_anomaly_pipeline.joblib

# --- Upload ---
MAX_UPLOAD_SIZE_MB=20
